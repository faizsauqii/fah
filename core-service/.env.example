# Salin ke .env untuk menjalankan core-service sendirian di laptop.
# Di STB, variabel ini diisi lewat .env di root repo (dikelola Anggota S).
NODE_ENV=development
PORT=3000
CORE_DB_PATH=./data/core.db

# Harus SAMA dengan auth-service. Minimal 32 karakter. Jangan di-commit.
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ISSUER=jamhijau-auth
JWT_AUDIENCE=jamhijau

# Harus SAMA dengan auth-service dan BERBEDA dari JWT_SECRET. Minimal 32 karakter.
# Dikirim sebagai header X-Internal-Token ke /internal/ di auth-service.
INTERNAL_TOKEN=ganti-dengan-string-acak-lain-minimal-32-karakter

AUTH_INTERNAL_URL=http://auth-service:3001
AUTH_TIMEOUT_MS=3000
API_KEY_CACHE_SECONDS=60

OPEN_METEO_USER_AGENT=JamHijau/1.0 (kelompok-fah K02)
OPEN_METEO_TIMEOUT_MS=5000
ENV_CACHE_TTL_MINUTES=60
