# Salin ke .env lalu isi. File .env TIDAK BOLEH di-commit.

# --- Bersama (core-service + auth-service) ---
# Minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=jamhijau-auth
JWT_AUDIENCE=jamhijau
JWT_EXPIRES_IN_SECONDS=604800
AUTH_INTERNAL_URL=http://auth-service:3001
# WAJIB. Header X-Internal-Token antara core-service dan auth-service.
# Minimal 32 karakter acak dan HARUS berbeda dari JWT_SECRET: openssl rand -base64 48
INTERNAL_TOKEN=

# --- auth-service (Anggota S) ---
AUTH_DB_PATH=/data/auth.db
# Akun admin (penerbit API key) dan akun uji untuk dosen/kelompok lain.
ADMIN_EMAIL=admin@jamhijau.stei.site
ADMIN_PASSWORD=
DEMO_EMAIL=demo@jamhijau.stei.site
DEMO_PASSWORD=

# --- core-service (Anggota N) ---
CORE_DB_PATH=/data/core.db
OPEN_METEO_USER_AGENT=JamHijau/1.0 (kelompok-jamhijau K02)
OPEN_METEO_TIMEOUT_MS=5000
ENV_CACHE_TTL_MINUTES=60

# --- Tunnel (hanya di STB) ---
# Dari dashboard Cloudflare Zero Trust > Networks > Tunnels > token.
TUNNEL_TOKEN=
