# Salin ke .env (sejajar package.json), lalu jalankan: npx expo start -c
# Hanya variabel berawalan EXPO_PUBLIC_ yang dibaca aplikasi. Jangan taruh rahasia di sini.
#
# Server publik (https, dipakai juga untuk APK):
EXPO_PUBLIC_API_URL=https://fah.stei.site/api
#
# Backend lokal di laptop (docker compose up di root repo). HP harus satu Wi-Fi
# dengan laptop; ganti 192.168.x.x dengan IP laptop, jangan "localhost".
# Catatan: docker-compose.yml mem-bind gateway ke 127.0.0.1:8080, jadi HP tidak
# bisa menjangkaunya. Lihat mobile/README.md bagian "Backend lokal".
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8080/api
